<!-- Custom Wazuh rules used in the SOC Home Lab -->

<group name="windows,account_management,">

  <rule id="100200" level="12">
    <if_sid>60110</if_sid>
    <field name="win.eventdata.targetUserName">Convidado</field>
    <description>Windows: Guest account enabled</description>
    <mitre>
      <id>T1098</id>
    </mitre>
    <group>windows,account_management,</group>
  </rule>

</group>

<group name="local,sshd,syslog,authentication_fail,">

  <rule id="100101" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <description>SSH: 3 or more failed login attempts from the same IP within 2 minutes</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,ssh_brute_force,credential_access</group>
  </rule>

</group>
